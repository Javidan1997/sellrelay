# SellRelay environment template. Copy to .env and fill in. Never commit real values.
# Values marked "local-only" are safe placeholders for docker-compose development.

NODE_ENV=development
LOG_LEVEL=info
DEPLOY_ENV=local            # local | staging | production

# --- PostgreSQL ---------------------------------------------------------------
# Admin URL is used ONLY by `pnpm db:bootstrap` in local dev / CI.
DATABASE_ADMIN_URL=postgres://postgres:postgres-local-only@localhost:5432/postgres
DATABASE_NAME=sellrelay
DB_MIGRATOR_PASSWORD=change-me-local-only
DB_API_PASSWORD=change-me-local-only
DB_WORKER_PASSWORD=change-me-local-only
DB_OPS_PASSWORD=change-me-local-only
DATABASE_URL_MIGRATOR=postgres://sellrelay_migrator:change-me-local-only@localhost:5432/sellrelay
DATABASE_URL_API=postgres://sellrelay_api:change-me-local-only@localhost:5432/sellrelay
DATABASE_URL_WORKER=postgres://sellrelay_worker:change-me-local-only@localhost:5432/sellrelay
DATABASE_URL_OPS=postgres://sellrelay_ops:change-me-local-only@localhost:5432/sellrelay

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Secrets encryption -------------------------------------------------------
# Local keyring (JSON array of {id, key(base64, 32 bytes)}). Production uses KMS envelope
# encryption (SECRETS_PROVIDER=aws-kms, SECRETS_KMS_KEY_ID=...).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_PROVIDER=local
SECRETS_KEYRING=[{"id":"local-1","key":"REPLACE_WITH_BASE64_32_BYTES"}]
SECRETS_ACTIVE_KEY_ID=local-1
# SECRETS_KMS_KEY_ID=arn:aws:kms:eu-central-1:000000000000:key/REPLACE

# --- Shopify app (from the Partner Dashboard / `shopify app env show`) ---------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_APP_URL=https://your-tunnel.example.com
SHOPIFY_APP_HANDLE=sellrelay
SHOPIFY_SCOPES=read_products,read_inventory,read_locations

# --- API / shell ----------------------------------------------------------------
API_PORT=8080
API_HOST=0.0.0.0
INTERNAL_METRICS_PORT=9464
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=
# Shared secret the shell uses when proxying to the API (defence in depth, not auth).
SHELL_PROXY_SECRET=change-me-local-only

# --- Worker ---------------------------------------------------------------------
WORKER_CONCURRENCY=8
WORKER_HEALTH_PORT=9465
WORKER_DRAIN_TIMEOUT_MS=30000

# --- Alerts -------------------------------------------------------------------
# Slack incoming webhook (validated: https://hooks.slack.com only)
ALERT_SLACK_WEBHOOK_URL=

# --- Telemetry ------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sellrelay
